{
  "name": "satellite.js",
  "version": "6.0.1",
  "description": "SGP4/SDP4 calculation library",
  "main": "lib/index.js",
  "jsnext:main": "dist/satellite.es.js",
  "types": "types/index.d.ts",
  "module": "dist/satellite.es.js",
  "type": "module",
  "scripts": {
    "build": "rimraf lib dist compiled types && tsc && npm run transpile && npm run dist",
    "transpile": "babel compiled --out-dir lib --ignore indexUmd.js",
    "dist": "npm run dist:es && npm run dist:umd:dev && npm run dist:umd:prod",
    "dist:es": "rollup --bundleConfigAsCjs --config rollup.config.es.js",
    "dist:umd": "rollup --bundleConfigAsCjs --config rollup.config.js",
    "dist:umd:dev": "cross-env NODE_ENV=development npm run dist:umd",
    "dist:umd:prod": "cross-env NODE_ENV=production npm run dist:umd",
    "watch:es": "node --require @babel/register rollup.watch.es.js",
    "copy": "copyfiles -u 1 'dist/**/*' sgp4_verification/lib/sgp4",
    "lint": "eslint src",
    "lint:test": "eslint test",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "raise": "raise-version",
    "prepublishOnly": "npm run lint && npm run lint:test && npm test && npm run build",
    "wasm:serve": "vite serve simd-test",
    "wasm:build:debug": "em++ src-cpp/js-addons.cpp src-cpp/SGP4.cpp --emit-tsd index.d.ts -g -msimd128 -sEXPORTED_FUNCTIONS=_malloc,_free,___lsan_do_recoverable_leak_check -sMODULARIZE -sEXPORT_ES6 -sEXPORT_NAME=\"Module\" -o wasm-build/debug/index.js -Rpass=loop-vectorize -Rpass-missed=loop-vectorize -Rpass-analysis=loop-vectorize -sALLOW_MEMORY_GROWTH -sEXPORTED_RUNTIME_METHODS=UTF8ToString,stringToUTF8,lengthBytesUTF8 -fsanitize=leak",
    "wasm:build:release": "em++ src-cpp/js-addons.cpp src-cpp/SGP4.cpp --emit-tsd index.d.ts -O3 -msimd128 -sEXPORTED_FUNCTIONS=_malloc,_free -sMODULARIZE -sEXPORT_ES6 -sEXPORT_NAME=\"Module\" -o wasm-build/release/index.js -Rpass=loop-vectorize -Rpass-missed=loop-vectorize -Rpass-analysis=loop-vectorize -sALLOW_MEMORY_GROWTH -sEXPORTED_RUNTIME_METHODS=UTF8ToString,stringToUTF8,lengthBytesUTF8",
    "wasm:build": "npm run wasm:build:debug && npm run wasm:build:release",
    "wasm:bench": "vitest bench --run --project \"WASM release\""
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/shashwatak/satellite-js"
  },
  "keywords": [
    "sgp4",
    "sdp4",
    "satellite",
    "TLE",
    "two-line elements",
    "OMM",
    "sgp4prop"
  ],
  "author": "Shashwat Kandadai <shashwatak@gmail.com> (https://github.com/shashwatak)",
  "contributors": [
    "Dmitriy Pushkov <ezze@ezze.org> (http://www.ezze.org)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shashwatak/satellite-js/issues"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.12",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-json-strings": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/preset-env": "^7.20.2",
    "@babel/register": "^7.18.9",
    "@eslint/js": "^9.22.0",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-terser": "^0.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "chokidar": "^3.5.3",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "^2.26.0",
    "glob": "^8.0.3",
    "jest": "^29.7.0",
    "prepend-file": "^2.0.1",
    "raise-version": "^0.5.0",
    "rimraf": "^3.0.2",
    "rollup": "^3.9.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "homepage": "https://github.com/shashwatak/satellite-js",
  "directories": {
    "lib": "lib",
    "test": "test"
  }
}
